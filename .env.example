SECRET_KEY=change-this-local-development-key-before-using-production-123456789
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5000
SITE_ID=1

DB_NAME=django_template
DB_USERNAME=django_template
DB_PASSWORD=change-this-local-database-password
DB_HOSTNAME=database
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Use SMTP and configure credentials in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional: configure providers here OR create SocialApp records in Django admin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY=
# PEM private key with literal \n between lines.
APPLE_CERTIFICATE_KEY=

# Required for the production Caddy service.
CADDY_PORT=80
CADDY_EMAIL=admin@example.com
DOMAIN=example.com
